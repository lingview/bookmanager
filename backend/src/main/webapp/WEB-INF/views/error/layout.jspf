<%@ page pageEncoding="UTF-8" %>
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><c:out value="${errorTitle}"/></title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI",
            Roboto, "Helvetica Neue", Arial, sans-serif;
            background-color: #f5f7fa;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }

        .box {
            text-align: center;
        }

        .code {
            font-size: 56px;
            font-weight: 600;
            color: #303133;
            line-height: 1.2;
        }

        .message {
            margin: 12px 0 24px;
            font-size: 14px;
            color: #606266;
        }

        .link {
            font-size: 14px;
            color: #409eff;
            text-decoration: none;
        }

        .link:hover {
            text-decoration: underline;
        }
    </style>
</head>

<body>
<div class="box">
    <div class="code"><c:out value="${errorTitle}"/></div>
    <p class="message"><c:out value="${errorMessage}"/></p>
    <a class="link" href="${pageContext.request.contextPath}/">返回首页</a>
</div>
</body>
</html>