<%@ page pageEncoding="UTF-8" %>
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><c:out value="${pageTitle}"/></title>
    <script>
        (function () {
            try {
                if (localStorage.getItem('app-theme') === 'dark') {
                    document.documentElement.classList.add('theme-dark');
                }
            } catch (e) {
            }
        })();
    </script>
    <link rel="stylesheet" href="${ctx}/assets/app.css">
</head>
<body>
<div class="nav">
    <div class="nav-group">
        <a class="brand" href="${ctx}/">Astra</a>
        <a class="nav-link ${navActive == 'books' ? 'active' : ''}" href="${ctx}/books">图书</a>
        <a class="nav-link ${navActive == 'reading' ? 'active' : ''}" href="${ctx}/reading">阅读</a>
        <a class="nav-link ${navActive == 'stats' ? 'active' : ''}" href="${ctx}/books/stats">统计</a>
        <c:if test="${canManage}">
            <a class="nav-link ${navActive == 'categories' ? 'active' : ''}" href="${ctx}/books/categories">分类</a>
        </c:if>
        <c:if test="${isAdmin}">
            <a class="nav-link ${navActive == 'users' ? 'active' : ''}" href="${ctx}/admin/users">用户</a>
        </c:if>
        <a class="nav-link" href="${ctx}/books/random">随便看看</a>
    </div>
    <div class="nav-group">
        <button type="button" class="link-btn theme-toggle" id="appThemeToggle" title="切换到夜间模式"
                aria-label="切换到夜间模式">
            <span id="appThemeIcon">☾</span>
        </button>
        <span class="user"><c:out value="${sessionScope.username}"/></span>
        <form action="${ctx}/logout" method="post" class="inline">
            <input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>">
            <button type="submit" class="link-btn">退出</button>
        </form>
    </div>
</div>
<script>
    (function () {
        var root = document.documentElement;
        var button = document.getElementById('appThemeToggle');
        var icon = document.getElementById('appThemeIcon');
        if (!button || !icon) return;

        function isDark() {
            return root.classList.contains('theme-dark');
        }

        function paint() {
            icon.textContent = isDark() ? '☀' : '☾';
            var title = isDark() ? '切换到日间模式' : '切换到夜间模式';
            button.title = title;
            button.setAttribute('aria-label', title);
        }

        function set(theme) {
            if (theme === 'dark') {
                root.classList.add('theme-dark');
            } else {
                root.classList.remove('theme-dark');
            }
            try {
                localStorage.setItem('app-theme', theme);
            } catch (e) {
            }
            paint();
            document.dispatchEvent(new CustomEvent('app-theme-change', { detail: { theme: theme } }));
        }

        function toggle() {
            var next = isDark() ? 'light' : 'dark';
            var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (!document.startViewTransition || reduced) {
                set(next);
                return;
            }
            var rect = button.getBoundingClientRect();
            var x = rect.left + rect.width / 2;
            var y = rect.top + rect.height / 2;
            var radius = Math.hypot(Math.max(x, window.innerWidth - x), Math.max(y, window.innerHeight - y));
            root.style.setProperty('--ripple-x', x + 'px');
            root.style.setProperty('--ripple-y', y + 'px');
            root.style.setProperty('--ripple-r', radius + 'px');
            document.startViewTransition(function () { set(next); });
        }

        window.AppTheme = {
            isDark: isDark,
            set: function (theme) {
                if (theme === 'dark') {
                    if (!isDark()) set('dark');
                } else if (isDark()) {
                    set('light');
                } else {
                    paint();
                }
            },
            toggle: toggle
        };

        button.addEventListener('click', toggle);
        paint();
    })();
</script>
<main class="page">
<c:if test="${not empty flashMessage}">
    <div class="flash ok"><c:out value="${flashMessage}"/></div>
</c:if>
<c:if test="${not empty flashError}">
    <div class="flash err"><c:out value="${flashError}"/></div>
</c:if>